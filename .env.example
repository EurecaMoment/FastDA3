# Copy to .env; this file contains examples, not credentials.
DA3_API_KEY=replace-with-your-own-secret
CUDA_VISIBLE_DEVICES=0
# Relative paths below are resolved from the repository by scripts/serve.sh.
DA3_MODEL_DIR=./weights/DA3NESTED-GIANT-LARGE-1.1
DA3_SALAD_CHECKPOINT=./weights/dino_salad.ckpt
DA3_DINOV2_REPO=./vendor/dinov2
DA3_STREAMING_REPO=./da3_streaming
DA3_DATA_DIR=./runtime
HF_HUB_OFFLINE=1
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=8
