[Unit]
Description=FastDA3 depth, pose and video API
After=network.target

[Service]
Type=simple
# Change both paths to your checkout and virtual environment.
WorkingDirectory=/opt/FastDA3
Environment=PYTHON=/opt/FastDA3/.venv/bin/python
ExecStart=/bin/bash /opt/FastDA3/scripts/serve.sh --port 8035
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=75
TimeoutStartSec=600
TimeoutStopSec=30
KillMode=control-group
MemoryMax=24G
LimitNOFILE=65536

[Install]
WantedBy=default.target
